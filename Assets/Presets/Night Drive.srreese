    <PARAM id="filter24db" value="1"/>
    <PARAM id="lfoSyncRate" value="9"/>
    <PARAM id="glideTime" value="0.05"/>
    <PARAM id="unisonVoices" value="3"/>
    <PARAM id="oscAWave" value="1"/>
    <PARAM id="oscBWave" value="0"/>
    <PARAM id="attack" value="0.005"/>
    <PARAM id="decay" value="0.2"/>
    <PARAM id="sustain" value="0.8"/>
