<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Night Drive" category="Dark" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="output" value="0.75"/>
    <PARAM id="detune" value="18"/>
    <PARAM id="sub" value="0.45"/>
    <PARAM id="cutoff" value="700"/>
    <PARAM id="resonance" value="0.8"/>
    <PARAM id="drive" value="0.45"/>
    <PARAM id="lfoRate" value="0.8"/>
    <PARAM id="lfoDepth" value="0.5"/>
